{
  "name": "hcm-lite",
  "version": "1.0.0",
  "description": "HCM Lite - AI-assisted Human Capital Management System",
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "backend": "npm --prefix backend start",
    "frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "geolib": "^3.3.4",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0"
  }
}
